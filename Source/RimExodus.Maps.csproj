<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/RimWorldReferences.props" />
  <PropertyGroup>
    <AssemblyName>RimExodus.Maps</AssemblyName>
    <RootNamespace>RimExodus.Maps</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Laurence-042</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../$(RimWorldVersion)/Assemblies/</OutputPath>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
